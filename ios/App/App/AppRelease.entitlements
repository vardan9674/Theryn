<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- development = sandbox APNs (Xcode builds, TestFlight)  -->
	<!-- production  = production APNs (App Store)              -->
	<!-- Automatic signing swaps this at archive time.          -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Sign in with Apple: required by App Review guideline 4.8 because the app offers Google sign-in. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
