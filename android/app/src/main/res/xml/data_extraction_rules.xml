<?xml version="1.0" encoding="utf-8"?>
<!--
  Theryn keeps the signed-in session and cached training data on the device.
  None of it is copied to Google Drive backups or to a new phone: the account
  lives on the server, so signing in again restores everything without moving
  session tokens off the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
